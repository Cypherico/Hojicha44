# Local dependencies, environments, and caches
node_modules/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local work and build output
/opencode/
/out/
/pcb/kicad/export/
/case/out*/
!/case/out/
/case/out/**
!/case/out/*.step

# Keep the canonical layout inputs consumed by PCB, plate, and CI.
/layout/generated/**
!/layout/generated/v2/
!/layout/generated/v2/points/
!/layout/generated/v2/points/points.yaml
!/layout/generated/v2/outlines/
!/layout/generated/v2/outlines/board.dxf

# KiCad local state and reports. Keep reports inside versioned PCB releases.
*.kicad_prl
*-backups/
.backup/
*.rpt

# Versioned releases, print records, and renders belong in Git.
/generated/*
!/generated/release/
!/generated/release/**
!/generated/print/
!/generated/renders/
!/generated/renders/**
/generated/renders/assets/

# Keep these last so they also apply inside versioned output directories.
.DS_Store
._*
Thumbs.db
Desktop.ini
*.log
*.lck
*.swp
*.swo
